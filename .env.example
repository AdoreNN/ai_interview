APP_ENV=development
POSTGRES_DB=grillo
POSTGRES_USER=grillo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8000
RESUME_PARSER_PORT=8001
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://grillo:change-me@localhost:5432/grillo
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000
RESUME_PARSER_URL=http://resume-parser:8000
ANALYST_URL=http://analyst:8000
ANALYST_PORT=8002
MAX_RESUME_BYTES=5000000
INTERVIEW_HR_TOPICS=3
INTERVIEW_TECH_TOPICS=4
INTERVIEW_MANAGER_TOPICS=3
INTERVIEW_MAX_FOLLOWUPS=2

# stub запускает проект локально без внешнего LLM; для GigaChat укажите gigachat и credentials.
LLM_MODE=stub
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL=false
GITHUB_TOKEN=
